 __init__(self, split=\"train\", image_size=256, augment=False):\n\n        self.split = split\n        self.image_size = image_size\n        self.augment = augment\n\n        self.rgb_path = os.path.join(\n            DATASET_PATH, split, \"RGB\"\n        )\n\n        self.thermal_path = os.path.join(\n            DATASET_PATH, split, \"thermal_8_bit\"\n        )\n\n        # Get RGB image IDs\n        rgb_ids = {\n            os.path.splitext(f)[0]\n            for f in os.listdir(self.rgb_path)\n            if f.lower().endswith((\".jpg\", \".jpeg\", \".png\"))\n        }\n\n        # Get thermal image IDs\n        thermal_ids = {\n            os.path.splitext(f)[0]\n            for f in os.listdir(self.thermal_path)\n            if f.lower().endswith((\".jpg\", \".jpeg\", \".png\"))\n        }\n\n        # Keep only matching pairs\n        self.image_ids = sorted(rgb_ids & thermal_ids)\n\n        print(f\"{split.upper()} dataset\")\n        print(\"Valid pairs:\", len(self.image_ids))\n        print(\"Augmentation:\", self.augment)\n\n    def __len__(self):\n        return len(self.image_ids)\n\n    def __getitem__(self, idx):\n\n        image_id = self.image_ids[idx]\n\n        # Find files by ID instead of assuming extension\n        rgb_file = next(\n            os.path.join(self.rgb_path, f)\n            for f in os.listdir(self.rgb_path)\n            if os.path.splitext(f)[0] == image_id\n        )\n\n        thermal_file = next(\n            os.path.join(self.thermal_path, f)\n            for f in os.listdir(self.thermal_path)\n            if os.path.splitext(f)[0] == image_id\n        )\n\n        # Load images\n        rgb = Image.open(rgb_file).convert(\"RGB\")\n        thermal = Image.open(thermal_file).convert(\"L\")\n\n        # Resize\n        rgb = rgb.resize(\n            (self.image_size, self.image_size)\n        )\n\n        thermal = thermal.resize(\n            (self.image_size, self.image_size)\n        )\n\n        # -----------------------