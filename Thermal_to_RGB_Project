init__()\n\n        self.block = nn.Sequential(\n            nn.Conv2d(\n                in_channels,\n                out_channels,\n                kernel_size=3,\n                padding=1\n            ),\n            nn.ReLU(inplace=True),\n\n            nn.Conv2d(\n                out_channels,\n                out_channels,\n                kernel_size=3,\n                padding=1\n            ),\n            nn.ReLU(inplace=True)\n        )\n\n    def forward(self, x):\n        return self.block(x)\n\n\nclass BaselineUNet(nn.Module):\n\n    def __init__(self):\n        super().__init__()\n\n        # Encoder\n        self.enc1 = DoubleConv(1, 64)\n        self.enc2 = DoubleConv(64, 128)\n        self.enc3 = DoubleConv(128, 256)\n\n        # Bottleneck\n        self.bottleneck = DoubleConv(256, 512)\n\n        # Downsampling\n        self.pool = nn.MaxPool2d(2)\n\n        # Decoder\n        self.up3 = nn.ConvTranspose2d(\n            512, 256, kernel_size=2, stride=2\n        )\n        self.dec3 = DoubleConv(512, 256)\n\n        self.up2 = nn.ConvTranspose2d(\n            256, 128, kernel_size=2, stride=2\n        )\n        self.dec2 = DoubleConv(256, 128)\n\n        self.up1 = nn.ConvTranspose2d(\n            128, 64, kernel_size=2, stride=2\n        )\n        self.dec1 = DoubleConv(128, 64)\n\n        # Output: 64 → 3 RGB channels\n        self.output = nn.Conv2d(\n            64,\n            3,\n            kernel_size=1\n        )\n\n    def forward(self, x):\n\n        # Encoder\n        e1 = self.enc1(x)\n        e2 = self.enc2(self.pool(e1))\n        e3 = self.enc3(self.pool(e2))\n\n        # Bottleneck\n        b = self.bottleneck(self.pool(e3))\n\n        # Decoder + skip connections\n        d3 = self.up3(b)\n        d3 = torch.cat([d3, e3], dim=1)\n        d3 = self.dec3(d3)\n\n        d2 = self.up2(d3)\n        d2 = torch.cat([d2, e2], dim=1)\n        d2 = self.dec2(d2)\n\n        d1 = self.up1(d2)\n        d1 = torch.cat([d1, e1], dim=1)\n        d1 = self.dec1(d1)\n\n        # RGB output\n        output = self.output(d1)\n\n        # Keep output in 0–1\n        output = torch.sigmoid(output)\n\n        return output","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-30T09:11:24.212863Z","iopub.execute_input":"2026-09-30T09:11:24.213937Z","iopub.status.idle":"2026-09-30T09:11:24.225062Z","shell.execute_reply.started":"2026-09-30T09:11:24.213892Z","shell.execute_reply":"2026-09-30T09:11:24.224215Z"}},"outputs":[],"execution_count":3},{"cell_type":"markdown","source":"Step 7.2 — Create the model on the GPU","metadata":{}},{"cell_type":"code","source":"# Select device\ndevice = torch.device(\n    \"cuda\" if torch.cuda.is_available() else \"cpu\"\n)\n\n# Create model\nmodel = BaselineUNet().to(device)\n\nprint(\"Device:\", device)\nprint(\"Model created successfully!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-30T09:12:36.788623Z","iopub.execute_input":"2026-09-30T09:12:36.789219Z","iopub.status.idle":"2026-09-30T09:12:37.460477Z","shell.execute_reply.started":"2026-09-30T09:12:36.789186Z","shell.execute_reply":"2026-09-30T09:12:37.459649Z"}},"outputs":[{"name":"stdout","text":"Device: cuda\nModel created successfully!\n","output_type":"stream"}],"execution_count":4},{"cell_type":"markdown","source":"Step 7.3 — Test one batch","metadata":{}},{"cell_type":"code","source":"# Get one batch\nthermal_batch, rgb_batch, image_ids = next(iter(train_loader))\n\n# Move to GPU\nthermal_batch = thermal_batch.to(device)\nrgb_batch = rgb_batch.to(device)\n\n# Forward pass\nwith torch.no_grad():\n    predicted_rgb = model(thermal_batch)\n\nprint(\"Input thermal shape:\", thermal_batch.shape)\nprint(\"Ground truth RGB shape:\", rgb_batch.shape)\nprint(\"Predicted RGB shape:\", predicted_rgb.shape)\nprint(\"Predicted RGB range:\",\n      predicted_rgb.min().item(),\n      \"to\",\n      predicted_rgb.max().item())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"